<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sin este permiso Retrofit no carga nada (error típico #5). No borrar -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- T44: foto del certificado. required=false: la app también se instala en equipos sin cámara -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- T49: detectar si hay internet (ConnectivityManager) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Notificaciones push: en Android 13+ se pide en tiempo de ejecución; si la niegan, la app sigue igual -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Acceso con huella o rostro (US03) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- US29: el video de la demostración final se graba con la cámara y el micrófono -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SkillSwap">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.SkillSwap"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Push de Firebase: el servicio recibe el token nuevo y los mensajes con la app abierta -->
        <service
            android:name=".SkillSwapMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Con la app cerrada o en segundo plano, el sistema muestra la notificación con este canal e ícono -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="skillswap_updates" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <!-- Comparte con la cámara el archivo donde se guarda la foto (cache/certificates) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>